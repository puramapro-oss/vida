{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 120
    },
    "src/app/api/cron/sync-legifrance/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/admin/sync-legifrance/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-legifrance",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/account-deletion",
      "schedule": "0 3 * * *"
    }
  ],
  "installCommand": "git config --global url.\"https://${SMARANA_GIT_TOKEN}@github.com/\".insteadOf \"ssh://git@github.com/\" && npm install"
}
